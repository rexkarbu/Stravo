{
  "version": 8,
  "name": "Stravo 3D Terrain Demo - Kamojang",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "tiles": [
        "{{BASE_URL}}/tiles/vector/{z}/{x}/{y}.pbf"
      ],
      "minzoom": 11,
      "maxzoom": 13,
      "attribution": "\u00a9 OpenStreetMap contributors"
    },
    "terrain-dem": {
      "type": "raster-dem",
      "tiles": [
        "{{BASE_URL}}/tiles/dem/{z}/{x}/{y}.png"
      ],
      "tileSize": 256,
      "minzoom": 11,
      "maxzoom": 13,
      "encoding": "terrarium",
      "attribution": "Mapzen / Nextzen / SRTM / Copernicus DEM"
    }
  },
  "glyphs": "{{BASE_URL}}/glyphs/{fontstack}/{range}.pbf",
  "terrain": {
    "source": "terrain-dem",
    "exaggeration": 1.0
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#e8e4de"
      }
    },
    {
      "id": "hillshading",
      "type": "hillshade",
      "source": "terrain-dem",
      "paint": {
        "hillshade-illumination-direction": 315,
        "hillshade-exaggeration": 0.6,
        "hillshade-shadow-color": "#3b2f1e",
        "hillshade-highlight-color": "#ffffff",
        "hillshade-accent-color": "#4a6332"
      }
    },
    {
      "id": "land",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "land",
      "paint": {
        "fill-color": "#d8e8c8",
        "fill-opacity": 0.4
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water_polygons",
      "paint": {
        "fill-color": "#90b8e0",
        "fill-opacity": 0.8
      }
    },
    {
      "id": "streets",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "streets",
      "paint": {
        "line-color": "#f8f5ee",
        "line-width": 2.0,
        "line-opacity": 0.85
      }
    },
    {
      "id": "place-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place_labels",
      "layout": {
        "text-field": "{name}",
        "text-font": [
          "Open Sans Regular"
        ],
        "text-size": 13,
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#222222",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      }
    }
  ]
}